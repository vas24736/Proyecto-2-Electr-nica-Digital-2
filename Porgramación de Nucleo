/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* MCU Configuration--------------------------------------------------------*/

	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* Configure the system clock */
	SystemClock_Config();

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_USART2_UART_Init();
	MX_SPI2_Init();
	MX_I2C1_Init();
	MX_TIM6_Init();
	/* USER CODE BEGIN 2 */
	HAL_TIM_Base_Start_IT(&htim6);
	/* TxData = 25;

	 HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_RESET);
	 HAL_SPI_TransmitReceive(&hspi2, &TxData, &RxData, 1, HAL_MAX_DELAY);
	 HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_SET);*/
	/* USER CODE END 2 */

	/* Initialize leds */
	BSP_LED_Init(LED2);

	/* Initialize USER push-button, will be used to trigger an interrupt each time it's pressed.*/
	BSP_PB_Init(BUTTON_USER, BUTTON_MODE_EXTI);

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {

		/*TX_Buffer[0] = 'S';
		 HAL_I2C_Master_Transmit(&hi2c1, WriteSalveAddress, TX_Buffer, 1, HAL_MAX_DELAY);
		 HAL_Delay(1000);
		 TX_Buffer[0] = '0';
		 HAL_I2C_Master_Transmit(&hi2c1, WriteSalveAddress, TX_Buffer, 1, HAL_MAX_DELAY);
		 HAL_Delay(1000);*/

		i = 0;
		I = 1;
		HAL_UART_Transmit(&huart2, menu1, sizeof(menu1), HAL_MAX_DELAY);
		HAL_UART_Transmit(&huart2, menu2, sizeof(menu2), HAL_MAX_DELAY);
		HAL_UART_Transmit(&huart2, menu3, sizeof(menu3), HAL_MAX_DELAY);
		HAL_UART_Receive(&huart2, modo1, 1, HAL_MAX_DELAY);
		if (modo1[0] == '1') {
			HAL_UART_Transmit(&huart2, mensajeLed, sizeof(mensajeLed),
			HAL_MAX_DELAY);
			while (I == 1) {
				HAL_UART_Receive(&huart2, &caracter, 1, HAL_MAX_DELAY);

				if (caracter == '.') {
					if (i > 0)
						I = 0;
				} else if (i < sizeof(comando1) - 1) {
					comando1[i++] = caracter;
				}
			}

			comando1[i] = '\0';

			if (sscanf((char*) comando1, "%d,%d", &led, &tiempo) == 2) {
				if (led >= 1 && led <= 3 && tiempo > 0 && tiempo <= 10000) {

					spiTx[0] = (uint8_t) led;
					spiTx[1] = (uint8_t) ((tiempo >> 8) & 0xFF);
					spiTx[2] = (uint8_t) (tiempo & 0xFF);

					HAL_GPIO_WritePin(ESP32_CS_GPIO_Port,
					ESP32_CS_Pin, GPIO_PIN_RESET);

					HAL_SPI_Transmit(&hspi2, spiTx, 3,
					HAL_MAX_DELAY);

					HAL_GPIO_WritePin(ESP32_CS_GPIO_Port,
					ESP32_CS_Pin, GPIO_PIN_SET);

					HAL_NVIC_DisableIRQ(TIM6_DAC_IRQn);

					tiempoTimer = (uint32_t) tiempo;
					contadorTimer = 0;

					HAL_NVIC_EnableIRQ(TIM6_DAC_IRQn);
				}
			} else {
				uint8_t error2[] = "\r\nFormato incorrecto. Use LED,tiempo\r\n";

				HAL_UART_Transmit(&huart2, error2, sizeof(error2) - 1,
				HAL_MAX_DELAY);
			}
			HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_RESET);
			HAL_SPI_TransmitReceive(&hspi2, &TxData, &RxData, 1, HAL_MAX_DELAY);

			HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_SET);
			TxData = 1;

			HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_RESET);
			HAL_SPI_TransmitReceive(&hspi2, &TxData, &RxData, 1, HAL_MAX_DELAY);

			HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_SET);
			TxData = 0;

			HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_RESET);
			HAL_SPI_TransmitReceive(&hspi2, &TxData, &RxData, 1, HAL_MAX_DELAY);

			HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_SET);
		} else if (modo1[0] == '2') {
			for (int i = 0; i < 2; i++) {
				uint8_t mensaje[] = "\r\nSeleccionaste I2C\r\n";
				HAL_UART_Transmit(&huart2, mensaje, sizeof(mensaje) - 1,
				HAL_MAX_DELAY);
				uint8_t mensaje1[] = "\r\nValor de Sensor: \r\n";
				HAL_I2C_Master_Receive(&hi2c1, ReadSlaveAddress, RX_Buffer, 1,
						HAL_MAX_DELAY);

				HAL_UART_Transmit(&huart2, mensaje1, sizeof(mensaje1) - 1,
						HAL_MAX_DELAY);
			}
			// Convertir el valor recibido a texto
			char texto[10];

			sprintf(texto, "%u\r\n", RX_Buffer[0]);

			// Enviar el texto por UART
			HAL_UART_Transmit(&huart2, (uint8_t*) texto, strlen(texto),
					HAL_MAX_DELAY);

		} else {
			HAL_UART_Transmit(&huart2, error1, sizeof(error1), HAL_MAX_DELAY);
		}
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */
	}
	/* USER CODE END 3 */
}

