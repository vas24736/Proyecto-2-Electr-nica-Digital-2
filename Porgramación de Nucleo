void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
	if (htim->Instance == TIM6) {
		contadorTimer++;

		if (contadorTimer >= tiempoTimer) {
			contadorTimer = 0;

			HAL_GPIO_TogglePin(LED_TIMER_GPIO_Port,
			LED_TIMER_Pin);
		}
	}
}

